[Unit]
Description=Proxy tailnet sccache CI uploads to the local gateway
Requires=sccache-ci-upload-gateway.service
After=sccache-ci-upload-gateway.service

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:3915
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
LimitNOFILE=1024
