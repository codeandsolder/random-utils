[Unit]
Description=Kill stale filesystem crawler processes
Documentation=https://github.com/codeandsolder/random-utils

[Service]
Type=oneshot
ExecStart=/usr/local/bin/crawl-killer
EnvironmentFile=-/etc/random-utils/telemetry.env
StateDirectory=random-utils
StateDirectoryMode=0755
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_KILL
IPAddressDeny=any
IPAddressAllow=127.0.0.1/8 ::1/128
